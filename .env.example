# Local development only. Do not commit real credentials.
ENV_TYPE=development

# Optional runtime override. Leave unset to use appsettings.development.yaml.
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@localhost:5432/postgres

# Local PostgreSQL container settings.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# When vault.enabled=true, VaultService resolves this secret name from the
# environment-backed Phase 5 secret boundary. Do not put real values here.
# VAULT_DATABASE_URL=postgresql+asyncpg://user:<password>@host:5432/database

# Integration-test database created by docker/postgres/init/01-create-test-db.sql.
# Keep real credentials out of source control.
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:<password>@localhost:5432/word_cloud_test

# Phase 10 Gold Dataset locations for human-adjudicated evaluation.
# COURSE/MEDIA may point to approved local datasets. SOLDIER_CONCERN must point
# outside this repository because raw concern text must not be committed here.
# PHASE10_GOLD_COURSE_DIR=C:/datasets/word-cloud/course-gold
# PHASE10_GOLD_SOLDIER_DIR=C:/private-datasets/word-cloud/soldier-gold
# PHASE10_GOLD_MEDIA_DIR=C:/datasets/word-cloud/media-gold

