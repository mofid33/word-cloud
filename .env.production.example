ENV_TYPE=production
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=change-me
API_PORT=5000
IMAGE_TAG=local
LOG_LEVEL=INFO
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=
WORKER_READINESS_URL=http://api:5000/api/v1/health/ready

# Set explicit runtime URLs. Do not commit a populated production env file.
DATABASE_URL=postgresql+asyncpg://postgres:change-me@postgres:5432/postgres
TRANSIENT_PAYLOAD_REDIS_URL=redis://redis:6379/0

# Container resource ceilings. Tune only after target-machine measurement.
API_CPU_LIMIT=4.0
API_MEMORY_LIMIT=6g
API_PIDS_LIMIT=512
WORKER_CPU_LIMIT=4.0
WORKER_MEMORY_LIMIT=6g
WORKER_PIDS_LIMIT=512
