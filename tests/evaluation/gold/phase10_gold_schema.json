{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase10-gold-v1",
  "title": "Phase 10 Gold Dataset Contract",
  "type": "object",
  "$defs": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "dataset_id",
        "dataset_version",
        "profile",
        "guideline_version",
        "cases_file"
      ],
      "properties": {
        "schema_version": {
          "const": "phase10-gold-v1"
        },
        "dataset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
        },
        "dataset_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
        },
        "profile": {
          "enum": [
            "COURSE",
            "SOLDIER_CONCERN",
            "MEDIA"
          ]
        },
        "guideline_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
        },
        "cases_file": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.jsonl$"
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "text",
        "metadata"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "relevance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_text",
        "grade"
      ],
      "properties": {
        "canonical_text": {
          "type": "string",
          "minLength": 1
        },
        "grade": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guideline_version",
        "annotator_count",
        "adjudicated",
        "relevance"
      ],
      "properties": {
        "guideline_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
        },
        "annotator_count": {
          "type": "integer",
          "minimum": 1
        },
        "adjudicated": {
          "type": "boolean"
        },
        "relevance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/relevance"
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "split",
        "documents",
        "annotation"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
        },
        "split": {
          "enum": [
            "tuning",
            "holdout"
          ]
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/document"
          }
        },
        "annotation": {
          "$ref": "#/$defs/annotation"
        }
      }
    }
  }
}
